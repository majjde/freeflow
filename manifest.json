{
  "manifest_version": 3,
  "name": "Freeflow",
  "version": "4.0.0",
  "description": "Freeflow - Premium extension for Lovable with license protection.",
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "tabs",
    "sidePanel",
    "cookies"
  ],
  "host_permissions": [
    "https://*.lovable.dev/*",
    "https://api.lovable.dev/*",
    "https://lovable.dev/*",
    "https://lovable-api.com/*",
    "https://lov.powerkits.net/*",
    "https://lovablekey.zigital.in/*",
    "https://ex-backend-server-production.up.railway.app/*"
  ],
  "action": {
    "default_title": "Freeflow",
    "default_popup": "sidepanel.html",
    "default_icon": {
      "16": "assets/icon16.png",
      "32": "assets/icon32.png",
      "48": "assets/icon48.png",
      "128": "assets/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.lovable.dev/*",
        "https://lovable.dev/*"
      ],
      "js": [
        "pageHook.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://*.lovable.dev/*",
        "https://lovable.dev/*",
        "https://api.lovable.dev/*"
      ],
      "js": [
        "security-hardening.js",
        "extension-config.js",
        "license-guard.js",
        "lovable-auth.js",
        "lovable-feature-api.js",
        "i18n.js",
        "user-messages.js",
        "jszip.min.js",
        "hwFingerprint.js",
        "content-bridge.js",
        "sounds.js",
        "branding-overrides.js",
        "net-overrides.js",
        "content-templates.js",
        "content.js",
        "premium-features.js"
      ],
      "css": [
        "theme.css",
        "floating.css",
        "premium-upgrade.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "security-hardening.js",
        "pageHook.js",
        "sounds/error-payment.mp3",
        "sounds/error-ratelimit.mp3",
        "sounds/error-token.mp3",
        "assets/logo-master-lovable.png",
        "assets/logo-master-lovable-square.png",
        "assets/icon16.png",
        "assets/icon32.png",
        "assets/icon48.png",
        "assets/icon128.png",
        "premium-upgrade.css",
        "i18n.js",
        "branding-overrides.js",
        "net-overrides.js",
        "premium-features.js"
      ],
      "matches": [
        "https://*.lovable.dev/*",
        "https://lovable.dev/*"
      ]
    }
  ],
  "icons": {
    "16": "assets/icon16.png",
    "32": "assets/icon32.png",
    "48": "assets/icon48.png",
    "128": "assets/icon128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; default-src 'self'; connect-src 'self' https://ex-backend-server-production.up.railway.app https://lovablekey.zigital.in https://*.lovable.dev https://api.lovable.dev https://lovable-api.com https://lov.powerkits.net; img-src 'self' blob: data: https:; style-src 'self' 'unsafe-inline'; media-src 'self' data: blob:"
  },
  "short_name": "Freeflow"
}